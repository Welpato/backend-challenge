# Carregado automaticamente pelo `bun test` (NODE_ENV=test). Aponta para docker-compose.test.yml.
# Sem segredos: credenciais fixas de ambiente local.
# A aplicação conecta como `app` (só DML); as migrations rodam como `migrator` (DDL).
DATABASE_URL=postgresql://app:app@localhost:5433/wagering
MIGRATION_DATABASE_URL=postgresql://migrator:migrator@localhost:5433/wagering
SQS_ENDPOINT=http://localhost:4567
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOG_LEVEL=silent
