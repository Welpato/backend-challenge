{
  "name": "jungle-wagering-processor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "bun test test/unit",
    "test:integration": "NODE_ENV=test bun scripts/test-integration.ts",
    "test:integration:up": "bun run infra:test:up && bun run test:integration",
    "test:concurrency": "NODE_ENV=test TEST_SUITE=test/concurrency bun scripts/test-integration.ts",
    "test:load": "bun test/load/run.ts",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d",
    "infra:test:down": "docker compose -f docker-compose.test.yml down",
    "infra:wait": "bun scripts/wait-for-infra.ts",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "migrate:create": "bun scripts/migrate.ts create",
    "migrate:pending": "bun scripts/migrate.ts pending"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1136.0",
    "@mikro-orm/core": "7.2.4",
    "@mikro-orm/migrations": "7.2.4",
    "@mikro-orm/postgresql": "7.2.4",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
