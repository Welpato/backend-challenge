# Copie para .env para rodar a app fora do Docker (o Bun carrega .env automaticamente).
# Aponta para a infra do docker-compose.yml (postgres em 5432, LocalStack em 4566).
# Schema completo e defaults: src/config/env.schema.ts.
APP_ROLE=all
PORT=3000
LOG_LEVEL=info
# A aplicação conecta como `app` (só DML); as migrations rodam como `migrator` (DDL).
DATABASE_URL=postgresql://app:app@localhost:5432/wagering
MIGRATION_DATABASE_URL=postgresql://migrator:migrator@localhost:5432/wagering
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# INSTANCE_ID=local-1                 # default: hostname
# DB_LOCK_TIMEOUT_MS=3000
# SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
# SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
# SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
# SQS_WAIT_TIME_SECONDS=20           # consumidor (F12): long-poll
# SQS_MAX_RECEIVE_COUNT=5             # mesmo valor do redrive da fila (docker/localstack-init.sh)
# SQS_CONSUMER_MAX_IN_FLIGHT=50       # mensagens em processamento simultâneo por instância do consumidor
# SQS_RETRY_BACKOFF_BASE_MS=1000      # falha transitória: visibilidade = base·2^(recebimentos−1)
# SQS_RETRY_BACKOFF_MAX_MS=300000
# METRICS_COLLECT_INTERVAL_MS=5000    # gauges de banco (outbox_pending, outbox_lag_seconds, pending_references)
# HEALTH_CHECK_TIMEOUT_MS=2000
# SHUTDOWN_GRACE_MS=20000
# OUTBOX_POLL_INTERVAL_MS=250          # publisher da outbox (F11): intervalo com a fila vazia
# OUTBOX_BATCH_SIZE=50
# REPROCESSOR_INTERVAL_MS=1000         # reprocessador de PENDING_REFERENCE (F10)
# REPROCESSOR_BATCH_SIZE=50
# REPROCESSOR_LEASE_MS=30000
# PENDING_REFERENCE_TTL_MS=1800000     # 30 min
# PENDING_REFERENCE_MAX_ATTEMPTS=12
# PENDING_REFERENCE_BACKOFF_BASE_MS=2000
# PENDING_REFERENCE_BACKOFF_MAX_MS=300000
# FAULT_EXIT_AFTER_COMMIT=0           # só para testes de recuperação
# FAULT_EXIT_AFTER_PUBLISH=0          # só para testes da outbox
